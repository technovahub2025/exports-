/* =========================================================
   ZAZA EXPORTS — MODERN HEADER
========================================================= */

.zaza-header {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 9999;

  background:
    linear-gradient(
      135deg,
      rgba(3, 37, 65, 0.97) 0%,
      rgba(7, 65, 105, 0.96) 52%,
      rgba(9, 82, 130, 0.95) 100%
    );

  border-bottom: 1px solid rgba(255, 255, 255, 0.12);

  box-shadow:
    0 8px 30px rgba(0, 20, 40, 0.16);

  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
}

.zaza-header__container {
  width: min(1280px, calc(100% - 40px));
  min-height: 92px;
  margin: 0 auto;

  display: grid;
  grid-template-columns: 20% 65% 15%;
  align-items: center;
}

/* =========================================================
   LOGO
========================================================= */

.zaza-header__logo {
  display: flex;
  align-items: center;
}

.zaza-header__logo a {
  display: flex;
  align-items: center;
}

.zaza-header__logo img {
  display: block;
  width: auto;
  max-width: 190px;
  max-height: 58px;
  object-fit: contain;

  transition:
    transform 0.3s ease,
    filter 0.3s ease;
}

.zaza-header__logo a:hover img {
  transform: scale(1.025);
  filter: brightness(1.06);
}

/* =========================================================
   DESKTOP NAVIGATION
========================================================= */

.zaza-header__nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
}

.zaza-nav__link {
  position: relative;

  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;

  min-height: 44px;
  margin: 0;
  padding: 0 13px;

  border: 0;
  outline: 0;

  background: transparent;

  color: rgba(255, 255, 255, 0.94);

  font-family: "Poppins", sans-serif;
  font-size: 14px;
  font-weight: 500;
  line-height: 1;

  text-decoration: none;
  white-space: nowrap;

  cursor: pointer;

  transition:
    color 0.25s ease,
    background 0.25s ease,
    transform 0.25s ease;
}

.zaza-nav__link::after {
  content: "";

  position: absolute;
  left: 13px;
  right: 13px;
  bottom: 3px;

  height: 2px;

  border-radius: 999px;

  background: #ffca2f;

  transform: scaleX(0);
  transform-origin: center;

  transition: transform 0.25s ease;
}

.zaza-nav__link:hover,
.zaza-nav__link:focus,
.zaza-nav__link.active {
  color: #ffffff;
}

.zaza-nav__link:hover::after,
.zaza-nav__link.active::after {
  transform: scaleX(1);
}

.zaza-nav__link:hover {
  transform: translateY(-1px);
}

.zaza-nav__about-button {
  background: transparent !important;
  box-shadow: none !important;
}

/* =========================================================
   PRODUCTS
========================================================= */

.zaza-nav__products {
  position: relative;

  display: flex;
  align-items: center;
}

.zaza-nav__arrow {
  font-size: 10px;
  opacity: 0.8;

  transition: transform 0.25s ease;
}

.zaza-nav__products:hover .zaza-nav__arrow {
  transform: rotate(180deg);
}

/* =========================================================
   MAIN DROPDOWN
========================================================= */

.zaza-nav__products > .zaza-dropdown {
  position: absolute;
  top: calc(100% + 12px);
  left: 0;

  width: 250px;
  padding: 8px;

  background: rgba(255, 255, 255, 0.98);

  border: 1px solid rgba(7, 88, 133, 0.08);
  border-radius: 14px;

  box-shadow:
    0 18px 50px rgba(0, 25, 50, 0.22);

  opacity: 0;
  visibility: hidden;
  pointer-events: none;

  transform: translateY(10px);

  transition:
    opacity 0.22s ease,
    visibility 0.22s ease,
    transform 0.22s ease;
}

.zaza-nav__products > .zaza-dropdown::before {
  content: "";

  position: absolute;
  top: -6px;
  left: 28px;

  width: 12px;
  height: 12px;

  background: #ffffff;

  transform: rotate(45deg);
}

.zaza-nav__products:hover > .zaza-dropdown,
.zaza-nav__products:focus-within > .zaza-dropdown {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;

  transform: translateY(0);
}

/* =========================================================
   DROPDOWN ITEMS
========================================================= */

.zaza-dropdown__item {
  position: relative;

  display: flex;
  align-items: center;
  justify-content: space-between;

  width: 100%;
  box-sizing: border-box;

  min-height: 42px;
  padding: 10px 14px;

  border-radius: 9px;

  background: transparent;
  color: #263746;

  font-family: "Poppins", sans-serif;
  font-size: 13px;
  font-weight: 400;

  line-height: 1.35;

  text-decoration: none;

  cursor: pointer;

  transition:
    background 0.2s ease,
    color 0.2s ease,
    padding-left 0.2s ease;
}

.zaza-dropdown__item:hover {
  background: #eaf5fa;
  color: #075985;
  padding-left: 18px;
}

.zaza-dropdown__parent {
  cursor: default;
}

/* =========================================================
   NESTED DROPDOWNS
========================================================= */

.zaza-dropdown__nested {
  position: relative;
}

.zaza-dropdown__nested > .zaza-dropdown--nested {
  position: absolute;

  top: -8px;
  left: calc(100% + 6px);

  width: 225px;
  padding: 8px;

  background: rgba(255, 255, 255, 0.98);

  border: 1px solid rgba(7, 88, 133, 0.08);
  border-radius: 14px;

  box-shadow:
    0 18px 50px rgba(0, 25, 50, 0.22);

  opacity: 0;
  visibility: hidden;
  pointer-events: none;

  transform: translateX(10px);

  transition:
    opacity 0.22s ease,
    visibility 0.22s ease,
    transform 0.22s ease;
}

.zaza-dropdown__nested:hover > .zaza-dropdown--nested {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;

  transform: translateX(0);
}

.zaza-dropdown--wooden {
  top: -8px !important;
}

/* =========================================================
   E-CATALOGUE BUTTON
========================================================= */

.zaza-header__cta {
  display: flex;
  justify-content: flex-end;
  align-items: center;
}

.zaza-header__catalogue {
  position: relative;

  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;

  min-height: 46px;
  padding: 0 18px;

  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 11px;

  background:
    linear-gradient(
      135deg,
      #ffca2f,
      #ffd95a
    );

  color: #063b59;

  font-family: "Poppins", sans-serif;
  font-size: 13px;
  font-weight: 600;

  text-decoration: none;

  box-shadow:
    0 6px 18px rgba(0, 0, 0, 0.15);

  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease,
    background 0.25s ease;
}

.zaza-header__catalogue:hover {
  transform: translateY(-2px);

  background: #ffffff;

  color: #075985;

  box-shadow:
    0 10px 25px rgba(0, 0, 0, 0.2);
}

.zaza-header__catalogue span {
  font-size: 17px;

  transition:
    transform 0.25s ease;
}

.zaza-header__catalogue:hover span {
  transform: translate(2px, -2px);
}

/* =========================================================
   MOBILE TOGGLE
========================================================= */

.zaza-header__mobile-toggle {
  display: none;

  align-items: center;
  justify-content: center;

  width: 44px;
  height: 44px;

  padding: 0;

  border: 1px solid rgba(255, 255, 255, 0.16);
  border-radius: 11px;

  background: rgba(255, 255, 255, 0.08);

  color: #ffffff;

  font-size: 26px;
  line-height: 1;

  cursor: pointer;

  transition:
    background 0.25s ease,
    color 0.25s ease,
    transform 0.25s ease;
}

.zaza-header__mobile-toggle:hover {
  background: #ffca2f;
  color: #063b59;
  transform: translateY(-1px);
}

/* =========================================================
   MOBILE MENU
========================================================= */

.zaza-mobile-menu {
  display: none;
}

/* =========================================================
   TABLET
========================================================= */

@media (max-width: 1100px) and (min-width: 1025px) {

  .zaza-header__container {
    width: calc(100% - 30px);
    grid-template-columns: 22% 60% 18%;
  }

  .zaza-header__nav {
    gap: 2px;
  }

  .zaza-nav__link {
    padding: 0 8px;
    font-size: 12px;
  }

  .zaza-header__catalogue {
    padding: 0 12px;
    font-size: 12px;
  }
}

/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 1024px) {

  .zaza-header {
    position: absolute;

    background:
      linear-gradient(
        145deg,
        rgba(3, 37, 65, 0.98),
        rgba(7, 65, 105, 0.97)
      );
  }

  .zaza-header__container {
    width: 100%;
    min-height: 78px;

    padding: 0 16px;

    box-sizing: border-box;

    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .zaza-header__logo {
    flex: 1 1 auto;
    min-width: 0;
  }

  .zaza-header__logo img {
    max-width: min(170px, 72vw);
    max-height: 48px;
  }

  .zaza-header__nav,
  .zaza-header__cta {
    display: none;
  }

  .zaza-header__mobile-toggle {
    display: flex;

    flex: 0 0 44px;

    margin-left: 10px;
  }

  /* =====================================================
     MOBILE OFF-CANVAS
  ===================================================== */

  .zaza-mobile-menu {
    position: fixed;
    inset: 0;

    display: block;

    z-index: 100000;

    width: 100%;
    max-width: 100vw;

    box-sizing: border-box;

    background:
      radial-gradient(
        circle at 100% 0%,
        rgba(23, 125, 180, 0.45),
        transparent 35%
      ),
      linear-gradient(
        145deg,
        #032541 0%,
        #06466d 55%,
        #075985 100%
      );

    overflow-x: hidden;
    overflow-y: auto;

    transform: translateX(100%);

    transition:
      transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .zaza-mobile-menu--open {
    transform: translateX(0);
  }

  .zaza-mobile-menu__header {
    min-height: 78px;

    padding: 14px 16px;

    box-sizing: border-box;

    display: flex;
    align-items: center;
    justify-content: space-between;

    border-bottom: 1px solid rgba(255, 255, 255, 0.12);

    gap: 12px;
  }

  .zaza-mobile-menu__header img {
    display: block;

    max-width: min(170px, 70vw);
    max-height: 48px;

    object-fit: contain;
  }

  .zaza-mobile-menu__close {
    flex: 0 0 44px;

    width: 44px;
    height: 44px;

    padding: 0;

    border: 0;
    border-radius: 11px;

    background: #ffca2f;
    color: #063b59;

    font-size: 28px;
    line-height: 1;

    cursor: pointer;

    transition:
      transform 0.25s ease,
      background 0.25s ease;
  }

  .zaza-mobile-menu__close:hover {
    transform: rotate(90deg);
    background: #ffffff;
  }

  .zaza-mobile-menu__nav {
    width: 100%;
    box-sizing: border-box;

    padding: 12px 20px 40px;
  }

  .zaza-mobile-link {
    display: flex;
    align-items: center;
    justify-content: space-between;

    width: 100%;
    min-height: 50px;

    padding: 13px 4px;

    border: 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    outline: 0;

    background: transparent;

    color: rgba(255, 255, 255, 0.96);

    font-family: "Poppins", sans-serif;
    font-size: 15px;
    font-weight: 500;

    text-align: left;
    text-decoration: none;

    cursor: pointer;

    transition:
      color 0.2s ease,
      padding-left 0.2s ease;
  }

  .zaza-mobile-link:hover,
  .zaza-mobile-link.active {
    color: #ffca2f;
    padding-left: 9px;
  }

  .zaza-mobile-link--button {
    appearance: none;
    -webkit-appearance: none;
  }

  .zaza-mobile-submenu {
    margin: 5px 0 8px 6px;

    padding: 5px 0 5px 14px;

    border-left: 2px solid rgba(255, 202, 47, 0.55);
  }

  .zaza-mobile-sublink {
    display: flex;
    align-items: center;
    justify-content: space-between;

    width: 100%;
    min-height: 43px;

    padding: 10px 4px;

    border: 0;
    outline: 0;

    background: transparent;

    color: rgba(255, 255, 255, 0.82);

    font-family: "Poppins", sans-serif;
    font-size: 14px;
    font-weight: 400;

    text-align: left;
    text-decoration: none;

    cursor: pointer;

    transition:
      color 0.2s ease,
      padding-left 0.2s ease;
  }

  .zaza-mobile-sublink:hover {
    color: #ffca2f;
    padding-left: 8px;
  }

  .zaza-mobile-sublink--button {
    appearance: none;
    -webkit-appearance: none;
  }

  .zaza-mobile-nested {
    margin-left: 5px;

    padding-left: 13px;

    border-left: 1px solid rgba(255, 255, 255, 0.14);
  }
}

/* =========================================================
   SMALL PHONES
========================================================= */

@media (max-width: 380px) {

  .zaza-header__container {
    min-height: 74px;
    padding: 0 12px;
  }

  .zaza-header__logo img {
    max-width: 145px;
    max-height: 42px;
  }

  .zaza-header__mobile-toggle {
    width: 40px;
    height: 40px;

    flex-basis: 40px;

    margin-left: 8px;

    font-size: 24px;
  }

  .zaza-mobile-menu__header {
    min-height: 74px;
    padding: 12px;
  }

  .zaza-mobile-menu__header img {
    max-width: 145px;
    max-height: 42px;
  }

  .zaza-mobile-menu__close {
    width: 40px;
    height: 40px;

    flex-basis: 40px;

    font-size: 25px;
  }

  .zaza-mobile-menu__nav {
    padding-left: 16px;
    padding-right: 16px;
  }

  .zaza-mobile-link {
    font-size: 14px;
  }

  .zaza-mobile-sublink {
    font-size: 13px;
  }
}

/* =========================================================
   ABOUT SECTION SCROLL
========================================================= */

#about-company {
  scroll-margin-top: 100px;
}

/* =========================================================
   REDUCED MOTION
========================================================= */

@media (prefers-reduced-motion: reduce) {

  .zaza-nav__link,
  .zaza-dropdown__item,
  .zaza-header__catalogue,
  .zaza-header__mobile-toggle,
  .zaza-mobile-menu,
  .zaza-mobile-link,
  .zaza-mobile-sublink {
    transition: none !important;
  }
}

/* =========================================================
   MOBILE HEADER MENU — FIX
========================================================= */

@media (max-width: 767px) {

  .zaza-header {
    position: absolute;
    z-index: 99999;
  }

  .zaza-header__container {
    width: calc(100% - 28px);
    min-height: 76px;

    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* Hamburger */

  .zaza-header__menu-toggle {
    position: relative;
    z-index: 100001;

    display: flex !important;
    align-items: center;
    justify-content: center;

    width: 46px;
    height: 46px;

    padding: 0;
    margin: 0;

    border: 1px solid rgba(255,255,255,0.25);
    border-radius: 10px;

    background: rgba(255,255,255,0.10);
    color: #ffffff;

    cursor: pointer;
  }

  /* Mobile navigation */

  .zaza-header__mobile-menu {
    position: absolute !important;

    top: 100%;
    left: 0;
    right: 0;

    width: 100%;

    display: none;

    padding: 12px 16px 20px;

    background:
      linear-gradient(
        145deg,
        #032741,
        #075985
      );

    border-top: 1px solid rgba(255,255,255,0.12);
    border-bottom: 2px solid #ffca2f;

    box-shadow:
      0 15px 35px rgba(0,0,0,0.28);

    z-index: 100000;

    overflow-y: auto;
    max-height: calc(100vh - 76px);
  }

  /* Open state */

  .zaza-header__mobile-menu--open {
    display: block !important;
  }

  /* Mobile menu links */

  .zaza-header__mobile-menu a,
  .zaza-header__mobile-menu button {
    width: 100%;

    display: flex;
    align-items: center;

    min-height: 48px;

    padding: 12px 14px;

    margin: 3px 0;

    border: 0;
    border-radius: 9px;

    background: transparent;

    color: #ffffff !important;

    font-family: "Poppins", sans-serif;
    font-size: 15px;
    font-weight: 500;

    text-align: left;
    text-decoration: none;

    cursor: pointer;
  }

  .zaza-header__mobile-menu a:hover,
  .zaza-header__mobile-menu button:hover {
    background: rgba(255,255,255,0.10);
    color: #ffca2f !important;
  }

  /* Products dropdown inside mobile menu */

  .zaza-header__mobile-products {
    display: block;
    width: 100%;
  }

  .zaza-header__mobile-products a {
    padding-left: 28px;
    font-size: 14px;
  }

  /* Make sure menu isn't hidden by hero */

  .hero {
    position: relative;
    z-index: 1;
  }

  .zaza-header {
    isolation: isolate;
  }
}

/* =========================================================
   DESKTOP — NEVER SHOW MOBILE MENU
========================================================= */

@media (min-width: 768px) {

  .zaza-header__menu-toggle {
    display: none !important;
  }

  .zaza-header__mobile-menu {
    display: none !important;
  }

}


/* =========================================================
   MOBILE MENU — FIXED
========================================================= */

@media (max-width: 767px) {

  .zaza-mobile-menu {
    position: fixed !important;

    top: 76px !important;
    left: 0 !important;
    right: 0 !important;

    width: 100% !important;

    display: none !important;

    background:
      linear-gradient(
        145deg,
        #032741 0%,
        #075985 100%
      ) !important;

    border-top: 1px solid rgba(255,255,255,0.15);
    border-bottom: 2px solid #ffca2f;

    box-shadow:
      0 18px 40px rgba(0,0,0,0.30);

    z-index: 999999 !important;

    max-height: calc(100vh - 76px);

    overflow-y: auto;

    padding: 10px 16px 20px;

    box-sizing: border-box;
  }

  /* OPEN */

  .zaza-mobile-menu.zaza-mobile-menu--open {
    display: block !important;
  }

  /* Header inside menu */

  .zaza-mobile-menu__header {
    display: flex;

    align-items: center;
    justify-content: space-between;

    min-height: 48px;

    color: #ffffff;
  }

  /* Close button */

  .zaza-mobile-menu__close {
    display: flex !important;

    align-items: center;
    justify-content: center;

    width: 42px;
    height: 42px;

    border: 1px solid rgba(255,255,255,0.25);
    border-radius: 9px;

    background: rgba(255,255,255,0.08);

    color: #ffffff;

    cursor: pointer;
  }

  .zaza-mobile-menu__close:hover {
    background: rgba(255,255,255,0.16);
    color: #ffca2f;
  }

  /* Navigation */

  .zaza-mobile-menu__nav {
    display: flex !important;

    flex-direction: column !important;

    width: 100%;

    gap: 3px;

    margin: 5px 0 0;

    padding: 0;
  }

  /* All mobile navigation links/buttons */

  .zaza-mobile-menu__nav a,
  .zaza-mobile-menu__nav button {
    display: flex !important;

    align-items: center;

    width: 100% !important;

    min-height: 48px;

    padding: 12px 14px !important;

    margin: 0 !important;

    box-sizing: border-box;

    border: 0 !important;
    border-radius: 9px;

    background: transparent;

    color: #ffffff !important;

    font-family: "Poppins", sans-serif;

    font-size: 15px;

    font-weight: 500;

    text-align: left;

    text-decoration: none;

    cursor: pointer;
  }

  .zaza-mobile-menu__nav a:hover,
  .zaza-mobile-menu__nav button:hover {
    background: rgba(255,255,255,0.10);

    color: #ffca2f !important;
  }

  /* Products nested links */

  .zaza-mobile-menu__nav ul {
    width: 100%;

    margin: 0;
    padding: 0 0 4px;

    list-style: none;
  }

  .zaza-mobile-menu__nav li {
    width: 100%;

    list-style: none;
  }

  .zaza-mobile-menu__nav li a {
    padding-left: 28px !important;

    font-size: 14px;
  }

}

/* =========================================================
   DESKTOP
========================================================= */

@media (min-width: 768px) {

  .zaza-mobile-menu {
    display: none !important;
  }

}


/* =========================================================
   FINAL MOBILE MENU FIX
   The menu uses an off-canvas transform, so the open state
   must explicitly reset that transform.
========================================================= */

@media (max-width: 1024px) {

  .zaza-mobile-menu {
    position: fixed !important;
    inset: 0 !important;

    width: 100% !important;
    max-width: 100vw !important;

    display: block !important;

    z-index: 100000 !important;

    box-sizing: border-box !important;

    overflow-x: hidden !important;
    overflow-y: auto !important;

    transform: translateX(100%) !important;

    transition:
      transform 0.35s cubic-bezier(0.4, 0, 0.2, 1) !important;
  }

  .zaza-mobile-menu.zaza-mobile-menu--open {
    display: block !important;

    transform: translateX(0) !important;

    visibility: visible !important;
    opacity: 1 !important;
    pointer-events: auto !important;
  }

}

/* Make the menu links use the exact JSX classes */

@media (max-width: 1024px) {

  .zaza-mobile-menu__nav {
    display: block !important;
    width: 100% !important;
  }

  .zaza-mobile-link,
  .zaza-mobile-sublink {
    display: flex !important;
    width: 100% !important;
    box-sizing: border-box !important;
  }

}

/* Never show mobile menu on desktop */

@media (min-width: 1025px) {

  .zaza-mobile-menu {
    display: none !important;
  }

}


/* =========================================================
   MOBILE MENU — NORMAL DROPDOWN
========================================================= */

@media (max-width: 1024px) {

  .zaza-mobile-menu {
    position: absolute !important;

    top: 100% !important;
    left: 0 !important;
    right: 0 !important;

    width: 100% !important;
    max-width: 100% !important;

    height: auto !important;
    max-height: calc(100vh - 78px) !important;

    box-sizing: border-box !important;

    display: block !important;

    padding: 0 !important;

    background:
      linear-gradient(
        145deg,
        #032541 0%,
        #06466d 55%,
        #075985 100%
      ) !important;

    border-top: 1px solid rgba(255,255,255,0.12);
    border-bottom: 2px solid #ffca2f;

    box-shadow:
      0 15px 35px rgba(0,0,0,0.30);

    overflow-x: hidden !important;
    overflow-y: auto !important;

    transform: translateY(-10px) !important;

    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;

    transition:
      opacity 0.25s ease,
      transform 0.25s ease,
      visibility 0.25s ease !important;

    z-index: 100000 !important;
  }

  .zaza-mobile-menu.zaza-mobile-menu--open {
    display: block !important;

    transform: translateY(0) !important;

    opacity: 1 !important;
    visibility: visible !important;
    pointer-events: auto !important;
  }

  .zaza-mobile-menu__header {
    min-height: 58px !important;

    padding: 8px 16px !important;

    box-sizing: border-box;

    display: flex !important;
    align-items: center;
    justify-content: space-between;

    border-bottom: 1px solid rgba(255,255,255,0.12);
  }

  .zaza-mobile-menu__nav {
    width: 100% !important;

    padding: 8px 18px 18px !important;

    box-sizing: border-box;

    display: block !important;
  }

  .zaza-mobile-link {
    width: 100% !important;

    min-height: 46px !important;

    box-sizing: border-box;

    display: flex !important;
    align-items: center;
    justify-content: space-between;

    padding: 11px 6px !important;

    border-bottom: 1px solid rgba(255,255,255,0.09) !important;

    color: #ffffff !important;
  }

  .zaza-mobile-submenu {
    margin: 4px 0 6px 8px !important;

    padding: 3px 0 3px 12px !important;

    border-left: 2px solid rgba(255,202,47,0.55);
  }

  .zaza-mobile-sublink {
    min-height: 40px !important;

    padding: 9px 5px !important;

    color: rgba(255,255,255,0.84) !important;
  }

}

/* Desktop */

@media (min-width: 1025px) {

  .zaza-mobile-menu {
    display: none !important;
  }

}


/* =========================================================
   MOBILE MENU — NORMAL DROPDOWN
========================================================= */

@media (max-width: 1024px) {

  .zaza-mobile-menu {
    position: absolute !important;

    top: 100% !important;
    left: 0 !important;
    right: 0 !important;

    width: 100% !important;
    max-width: 100% !important;

    height: auto !important;
    max-height: calc(100vh - 78px) !important;

    box-sizing: border-box !important;

    display: block !important;

    padding: 0 !important;

    background:
      linear-gradient(
        145deg,
        #032541 0%,
        #06466d 55%,
        #075985 100%
      ) !important;

